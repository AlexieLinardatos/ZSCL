<mxfile host="app.diagrams.net"><diagram name="d"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="① Store an exemplar (end of each task)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1140" height="190" as="geometry"/></mxCell><mxCell id="b2" value="② Replay it (every training step on later tasks)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10" y="220" width="1140" height="360" as="geometry"/></mxCell><mxCell id="img" value="Image &lt;i&gt;x&lt;/i&gt;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="120" height="60" as="geometry"/></mxCell><mxCell id="low" value="ViT blocks 1–2&lt;br&gt;❄ frozen after task 0" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=hatch;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="180" height="70" as="geometry"/></mxCell><mxCell id="pq" value="Compress&lt;br&gt;(product quantization)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="85" width="170" height="60" as="geometry"/></mxCell><mxCell id="buf" value="&lt;b&gt;Replay buffer&lt;/b&gt;&lt;br&gt;compressed tokens&lt;br&gt;&lt;b&gt;25 KB&lt;/b&gt; vs 602 KB per image (24× smaller)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="n0" value="raw image is thrown away" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="690" y="172" width="250" height="20" as="geometry"/></mxCell><mxCell id="dec" value="Decompress → tokens" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="180" height="50" as="geometry"/></mxCell><mxCell id="up" value="ViT blocks 3–12&lt;br&gt;(trainable)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="355" width="180" height="70" as="geometry"/></mxCell><mxCell id="v" value="image emb." style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="775" y="465" width="110" height="40" as="geometry"/></mxCell><mxCell id="pr" value="&amp;quot;a photo of a {old class}&amp;quot;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="200" height="50" as="geometry"/></mxCell><mxCell id="te" value="Text encoder&lt;br&gt;(trainable)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="355" width="200" height="70" as="geometry"/></mxCell><mxCell id="T" value="text emb." style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75" y="465" width="110" height="40" as="geometry"/></mxCell><mxCell id="L" value="&lt;b&gt;L&lt;sub&gt;rep&lt;/sub&gt;&lt;/b&gt; = cross-entropy&lt;br&gt;(classify the old image)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="455" width="260" height="60" as="geometry"/></mxCell><mxCell id="g" value="gradient → text encoder + upper ViT blocks" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="300" height="20" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Key idea&lt;/b&gt;&lt;br&gt;• Store mid-network tokens, not pixels → many more exemplars per MB&lt;br&gt;• Lower blocks are frozen, so stored tokens never go stale&lt;br&gt;• Replay still trains the text encoder on old classes" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="260" width="190" height="240" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;━━▶&lt;/b&gt; gradient flows &amp;nbsp;&amp;nbsp; &lt;b&gt;- - ▶&lt;/b&gt; no gradient &amp;nbsp;&amp;nbsp; hatched = frozen" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="500" height="20" as="geometry"/></mxCell><mxCell id="e0" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="img" target="low"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="tokens" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="low" target="pq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="codes" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="pq" target="buf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="buf" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="dec" target="up"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="up" target="v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="pr" target="te"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="te" target="T"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v" target="L"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="T" target="L"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>