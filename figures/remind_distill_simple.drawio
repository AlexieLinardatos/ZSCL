<mxfile host="app.diagrams.net"><diagram name="d"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="① Store an exemplar (end of each task)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1160" height="250" as="geometry"/></mxCell><mxCell id="b2" value="② Distill on replayed exemplars (every training step)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10" y="280" width="1160" height="420" as="geometry"/></mxCell><mxCell id="img" value="Image &lt;i&gt;x&lt;/i&gt;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="120" height="60" as="geometry"/></mxCell><mxCell id="low" value="Student ViT blocks 1–2&lt;br&gt;❄ frozen" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=hatch;" vertex="1" parent="1"><mxGeometry x="210" y="45" width="190" height="65" as="geometry"/></mxCell><mxCell id="pq" value="Compress" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="52" width="130" height="50" as="geometry"/></mxCell><mxCell id="tea" value="Zero-shot CLIP&lt;br&gt;❄ frozen teacher" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="210" y="170" width="190" height="65" as="geometry"/></mxCell><mxCell id="vs" value="teacher emb. &lt;i&gt;v̂*&lt;/i&gt;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="182" width="140" height="40" as="geometry"/></mxCell><mxCell id="buf" value="&lt;b&gt;Replay buffer&lt;/b&gt;&lt;br&gt;• compressed tokens (25 KB)&lt;br&gt;• teacher emb. &lt;i&gt;v̂*&lt;/i&gt; (1 KB)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="290" height="150" as="geometry"/></mxCell><mxCell id="vs2" value="&lt;i&gt;v̂*&lt;/i&gt; (stored)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="330" width="140" height="40" as="geometry"/></mxCell><mxCell id="dec" value="Decompress → tokens" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="180" height="50" as="geometry"/></mxCell><mxCell id="up" value="Student ViT blocks 3–12&lt;br&gt;(trainable)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="415" width="200" height="70" as="geometry"/></mxCell><mxCell id="v" value="student emb. &lt;i&gt;v&lt;/i&gt;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="525" width="140" height="40" as="geometry"/></mxCell><mxCell id="rs" value="Reference sentences&lt;br&gt;(generic captions)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="200" height="55" as="geometry"/></mxCell><mxCell id="tt" value="Teacher text encoder&lt;br&gt;❄ frozen" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=18;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="200" height="65" as="geometry"/></mxCell><mxCell id="T" value="text emb. &lt;i&gt;T&lt;/i&gt;" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="120" height="40" as="geometry"/></mxCell><mxCell id="L" value="&lt;b&gt;L&lt;sub&gt;RD&lt;/sub&gt;&lt;/b&gt; = KL( p&lt;sub&gt;teacher&lt;/sub&gt; ‖ p&lt;sub&gt;student&lt;/sub&gt; )&lt;br&gt;p = softmax over sentences of (emb · &lt;i&gt;T&lt;/i&gt;)" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="600" width="380" height="70" as="geometry"/></mxCell><mxCell id="g" value="gradient → upper ViT blocks only" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="740" y="640" width="240" height="20" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Why&lt;/b&gt;&lt;br&gt;• Keeps how the model sees &lt;i&gt;old&lt;/i&gt; images close to zero-shot CLIP (ZSCL-style distillation, applied to the replay buffer)&lt;br&gt;• Teacher is frozen → target computed once at storage, never stale&lt;br&gt;• Student sees compressed tokens but must match the &lt;i&gt;clean&lt;/i&gt; image → upper blocks also learn to undo compression error" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="975" y="300" width="185" height="330" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;━━▶&lt;/b&gt; gradient flows &amp;nbsp;&amp;nbsp; &lt;b&gt;- - ▶&lt;/b&gt; no gradient &amp;nbsp;&amp;nbsp; hatched = frozen" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="300" height="20" as="geometry"/></mxCell><mxCell id="e0" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="img" target="low"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="img" target="tea"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="tokens" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="low" target="pq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="codes" style="fontFamily=Times New Roman;html=1;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=1.5;entryX=0;entry